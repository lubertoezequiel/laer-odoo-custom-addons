<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pricelist_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="product">
                <div style="border-bottom:1px solid #ccc; margin-bottom:20px; padding-bottom:10px;">
                    <img t-if="product.image_1920"
                         t-att-src="product.image_1920"
                         style="width:120px;"/>
                    <h2 t-esc="product.name"/>
                    <p>Precio: <t t-esc="product.list_price"/></p>
                    <p t-esc="product.descripcion_ampliada"/>
                </div>
            </t>
        </t>
    </template>
</odoo>