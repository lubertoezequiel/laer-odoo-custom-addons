<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        LAER TECHNOLOGY GROUP — Encabezado Compacto para todos los reportes
        Odoo 19 — XPaths basados en estructura real de web.external_layout_standard

        ESTRUCTURA REAL del header (web/views/report_templates.xml):
          <div class="header o_company_X_layout">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <img class="o_company_logo_small"/>
              <div class="o_company_tagline"/>
            </div>
            <div class="row">
              <div class="col-6" name="company_address">...</div>
            </div>
          </div>

          En el article:
            <t t-call="web.address_layout"/>   = bloque del cliente (div.address.row.mb-4)
            <h2 t-out="layout_document_title"/> = número de documento

        ESTRATEGIA:
          1. Reemplazar la fila "logo+tagline" por 2 columnas: logo | empresa
          2. Eliminar el row de company_address (ya incluido en col empresa arriba)
          3. CSS reduce h2 y tablas

        NOTA: se intentó varias veces alinear la dirección del cliente con la
        empresa (como 3ra columna en el header, y moviendo el header entero al
        body). Las dos causaron regresiones (superposición de contenido, y
        el cliente dejando de verse) sin poder confirmarlas visualmente antes
        de que el usuario las viera en producción. Se vuelve a la versión
        simple y ya probada: header con logo + empresa únicamente, dirección
        del cliente en el cuerpo vía web.address_layout normal (sin tocar),
        sólo con el CSS de compact_reports.css agrandando su tipografía.
        No volver a tocar esta alineación sin poder verificarla visualmente
        antes de pedirle al usuario que pruebe.
    -->

    <!-- =================================================================
         1. OVERRIDE: header de external_layout_standard
         ================================================================= -->
    <template id="laer_external_layout_standard"
              inherit_id="web.external_layout_standard"
              priority="20">

        <!-- Reemplazar la fila superior (logo + tagline) por header de 2 columnas.
             Se usa una <table> en vez de display:flex porque wkhtmltopdf (el motor
             que convierte el HTML a PDF) tiene soporte muy pobre de flexbox: el
             HTML se ve bien en el navegador pero el contenido queda invisible o
             mal posicionado en el PDF. Las tablas sí son 100% confiables ahí. -->
        <xpath expr="//div[hasclass('d-flex')][hasclass('justify-content-between')][hasclass('mb-2')]"
               position="replace">
            <table class="laer-header-row" style="width:100%; border-collapse:collapse; border:none;">
                <tr>

                    <!-- Columna 1: Logo -->
                    <td class="laer-logo-col" style="width:140px; vertical-align:top; padding-right:10px; border:none;">
                        <img t-if="company.logo"
                             class="o_company_logo_small"
                             t-att-src="image_data_uri(company.logo)"
                             alt="Logo"
                             style="max-height:50px;"/>
                    </td>

                    <!-- Columna 2: Tagline / nombre empresa. Si no hay tagline (company.report_header
                         vacio, como pasa en 'Cuenta'), mostramos nombre + direccion de la empresa
                         en su lugar para que la columna nunca quede en blanco. -->
                    <td class="laer-company-col" style="vertical-align:top; border:none;">
                        <div t-if="company.report_header"
                             t-field="company.report_header"
                             class="o_company_tagline fw-bold"/>
                        <div t-else="">
                            <div class="fw-bold" t-field="company.partner_id.name"/>
                            <div t-field="company.partner_id"
                                 t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                        </div>
                    </td>

                </tr>
            </table>
        </xpath>

        <!-- Eliminar el div.row con company_address (ya está integrado arriba vía tagline/company_details) -->
        <xpath expr="//div[hasclass('row')][.//div[@name='company_address']]"
               position="replace">
            <!-- company_address suprimido: los datos de empresa van en company_details / tagline -->
        </xpath>

    </template>

</odoo>
